{{!< default}}

<div class="gh-outer">
<main class="site-main gh-inner">

    {{#tag}}
        <section class="term">
            <h1 class="term-name">
                {{#foreach (split name separator=" &amp; ")}}
                   {{this}}
                {{/foreach}}
            </h1>
            <div class="term-description">{{description}}</div>
        </section>
    {{/tag}}

    <div class="post-feed gh-feed">
        {{#foreach posts}}
            {{> "loop"}}
        {{/foreach}}
    </div>

</main>
</div>
