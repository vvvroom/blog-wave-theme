<nav class="pagination" role="navigation">
    {{#if prev}}
        <a class="pagination-item pagination-prev" href="{{page_url prev}}">← Newer</a>
    {{else}}
        <span class="pagination-item pagination-prev is-disabled">← Newer</span>
    {{/if}}

    <span class="pagination-info">{{page}} / {{pages}}</span>

    {{#if next}}
        <a class="pagination-item pagination-next" href="{{page_url next}}">Older →</a>
    {{else}}
        <span class="pagination-item pagination-next is-disabled">Older →</span>
    {{/if}}
</nav>
